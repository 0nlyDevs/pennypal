VITE_GEMINI_API_KEY=Your_Gemini_API_Key

# Dev only: full API base including the /api suffix (e.g. http://localhost:4000/api)
# Do NOT set in production: the build defaults to relative /api (cloudflare pages function proxy)
VITE_API_BASE=http://localhost:8080/api

# Cloudflare Pages runtime variable (set in the Pages dashboard, NOT here):
# API_BASE = Backend origin the function proxies /api/* to, e.g. https://pennypal-ya7b.onrender.com