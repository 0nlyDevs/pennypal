# Test environment template. Copy to .env.test and fill in a disposable database
# (do not reuse the local dev or production database).
NODE_ENV=test
DATABASE_URL=postgres://<username>:<password>@localhost:5432/expense_tracker_test
DIRECT_URL=postgres://<username>:<password>@localhost:5432/expense_tracker_test

# Secrets used only by the test suite
JWT_SECRET=test-only-secret-change-me
ACCESS_TOKEN_TTL=5m
REFRESH_TOKEN_TTL_DAYS=1
JWT_ISSUER=expense-tracker
JWT_AUDIENCE=expense-tracker-api

# Login lockout thresholds
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_WINDOW_MS=60000

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
EMAIL_FROM=PennyPal <test@resend.dev>