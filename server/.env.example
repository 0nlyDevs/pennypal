# Server Configuration
PORT=8080
NODE_ENV=development

# Database Configuration
# Prefer Vercel Postgres variables when deploying on Vercel.
# For local dev, you can still use DATABASE_URL.
# Vercel will inject these automatically when you add the Vercel Postgres integration.
# POSTGRES_URL usually points to a pooled connection (safe to use with clients that do NOT create their own pool).
# POSTGRES_URL_NON_POOLING is a direct connection string (use with clients that manage their own pool).
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# Fallback local connection string (used when POSTGRES_* are not present)
DATABASE_URL=postgres://<username>:<password>@localhost:5432/<database>
# If using direct connection or non-pooled DB, set DIRECT_URL equal to DATABASE_URL
DIRECT_URL=postgres://<username>:<password>@localhost:5432/<database>

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Access token lifetime (jsonwebtoken expiresIn format, e.g. 15m, 1h)
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=30
# Issuer/audience claims pinned during verification
JWT_ISSUER=expense-tracker
JWT_AUDIENCE=expense-tracker-api

# Brute-force protection
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_WINDOW_MS=900000

# Frontend URL (used for redirects after OAuth); falls back to CORS_ORIGIN if not set
FRONTEND_URL=http://localhost:5173

# Public API base used for links in verification emails; defaults to FRONTEND_URL/api
API_PUBLIC_URL=http://localhost:8080/api

# CORS Configuration (frontend url)
CORS_ORIGIN=http://localhost:5173

# Google OAuth
# Create OAuth 2.0 Client ID (Web) at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include:
#   http://localhost:8080/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://your-deployed-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_TIMEOUT_MS=10000


### EMAIL CONFIGURATION (Resend)
# When RESEND_API_KEY is unset, verification emails are logged to the console
# instead of being sent (handy for local development).
RESEND_API_KEY=
EMAIL_FROM=PennyPal <onboarding@resend.dev>


### SUPABASE CONFIGURATION
SUPABASE_BUCKET_RECEIPTS=The_name_of_your_bucket
SUPABASE_SERVICE_ROLE_KEY=The_service_role_key
SUPABASE_URL=https://xxxx.supabase.co
